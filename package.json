{
  "name": "thesis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Open-source AI value investing research — local CLI pipeline producing One Pager, Pitch Deck, and Final Thesis reports via Claude Code.",
  "author": "Kyle Hoff <kyle@thesis-investing.com>",
  "license": "MIT",
  "homepage": "https://github.com/kyleghoff707/thesis",
  "repository": {
    "type": "git",
    "url": "https://github.com/kyleghoff707/thesis.git"
  },
  "bugs": {
    "url": "https://github.com/kyleghoff707/thesis/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/verify-bundle.mjs",
    "lint": "eslint .",
    "lint:vocab": "node scripts/lint-vocab.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "scan-tags": "node validation/scripts/bundle.mjs && node validation/scripts/scan-unknown-tags.mjs",
    "dump:transcripts": "node scripts/dump-r2-transcripts.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@xmldom/xmldom": "^0.8.11",
    "cheerio": "^1.2.0",
    "docx": "^9.6.1",
    "dotenv": "^17.3.1",
    "file-saver": "^2.0.5",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "linkedom": "^0.18.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5",
    "yahoo-finance2": "^3.13.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tauri-apps/cli": "^2.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.0.1",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  }
}

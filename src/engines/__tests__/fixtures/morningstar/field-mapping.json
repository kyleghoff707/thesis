{
  "_meta": {
    "description": "Maps Morningstar CSV field names to Thes1s XBRL engine field names",
    "signConvention": "sign = multiplier to convert MS value to Thes1s sign convention. thesisValue ≈ sign × msValue",
    "toleranceTiers": {
      "exact": "< 1% or < $1M difference — scoring-critical fields",
      "close": "< 5% — important display fields",
      "approximate": "< 10% — derived or definition-variable fields",
      "relaxed": "< 20% — financial-sector or structurally ambiguous fields",
      "informational": "no fail — known-divergent or unmapped"
    },
    "totalMapped": 87,
    "totalUnmapped": "~588 (industry-specific, sub-breakdowns, maturity schedules, supplementals)"
  },
  "income": {
    "Total Revenue": {
      "thesisField": "revenues",
      "sign": 1,
      "tolerance": "exact",
      "notes": null
    },
    "Cost of Revenue": {
      "thesisField": "cost_of_revenue",
      "sign": -1,
      "tolerance": "close",
      "notes": "MS negative, XBRL positive"
    },
    "Gross Profit": {
      "thesisField": "gross_profit",
      "sign": 1,
      "tolerance": "close",
      "notes": null
    },
    "Selling, General and Administrative Expenses": {
      "thesisField": "sga",
      "sign": -1,
      "tolerance": "close",
      "notes": "MS negative, XBRL positive. Some companies report SGA combined, others split selling + G&A"
    },
    "Selling and Marketing Expenses": {
      "thesisField": "selling_expense",
      "sign": -1,
      "tolerance": "close",
      "notes": "MS negative, XBRL positive. Sub-component of SGA"
    },
    "General and Administrative Expenses": {
      "thesisField": "general_and_admin_expense",
      "sign": -1,
      "tolerance": "close",
      "notes": "MS negative, XBRL positive. Sub-component of SGA"
    },
    "Research and Development Expenses": {
      "thesisField": "research_and_development",
      "sign": -1,
      "tolerance": "close",
      "notes": "MS negative, XBRL positive. Not all companies have R&D"
    },
    "Depreciation, Amortization and Depletion": {
      "thesisField": "depreciation_amortization_is",
      "sign": -1,
      "tolerance": "close",
      "notes": "MS negative, XBRL positive. IS D&A — often $0 for companies embedding D&A in COGS/SGA (AAPL, MSFT)"
    },
    "Total Operating Profit/Loss": {
      "thesisField": "operating_income_loss",
      "sign": 1,
      "tolerance": "exact",
      "notes": null
    },
    "Interest Income": {
      "thesisField": "interest_income",
      "sign": 1,
      "tolerance": "close",
      "notes": "Not all companies break out interest income"
    },
    "Interest Expense Net of Capitalized Interest": {
      "thesisField": "interest_expense",
      "sign": -1,
      "tolerance": "close",
      "notes": "MS negative, XBRL positive"
    },
    "Net Interest Income/Expense": {
      "thesisField": "net_interest_income",
      "sign": 1,
      "tolerance": "close",
      "notes": "Can be positive or negative"
    },
    "Other Income/Expense, Non-Operating": {
      "thesisField": "other_income_expense",
      "sign": 1,
      "tolerance": "informational",
      "notes": "Structural mismatch: MS normalizes (strips investment gains, FX). XBRL reports as-filed catch-all. 93 failures with 100-35000% deviation — unfixable without MS normalization logic."
    },
    "Pretax Income": {
      "thesisField": "income_before_tax",
      "sign": 1,
      "tolerance": "exact",
      "notes": null
    },
    "Provision for Income Tax": {
      "thesisField": "income_tax",
      "sign": -1,
      "tolerance": "exact",
      "notes": "MS negative (expense), XBRL positive. Tax benefit = positive in MS, negative in XBRL"
    },
    "Net Income before Extraordinary Items and Discontinued Operations": {
      "thesisField": "income_from_continuing_operations",
      "sign": 1,
      "tolerance": "exact",
      "notes": null
    },
    "Net Income after Extraordinary Items and Discontinued Operations": {
      "thesisField": "net_income_including_nci",
      "sign": 1,
      "tolerance": "exact",
      "notes": "Includes non-controlling interests. Same as net_income_loss for companies without NCI"
    },
    "Net Income after Non-Controlling/Minority Interests": {
      "thesisField": "net_income_loss",
      "sign": 1,
      "tolerance": "exact",
      "notes": "Primary net income field — attributable to parent"
    },
    "Basic EPS": {
      "thesisField": "basic_earnings_per_share",
      "sign": 1,
      "tolerance": "exact",
      "notes": "First occurrence only (deduped from supplemental section)"
    },
    "Diluted EPS": {
      "thesisField": "diluted_earnings_per_share",
      "sign": 1,
      "tolerance": "exact",
      "notes": "First occurrence only (deduped from supplemental section)"
    },
    "Basic Weighted Average Shares Outstanding": {
      "thesisField": "basic_average_shares",
      "sign": 1,
      "tolerance": "exact",
      "notes": null
    },
    "Diluted Weighted Average Shares Outstanding": {
      "thesisField": "diluted_average_shares",
      "sign": 1,
      "tolerance": "exact",
      "notes": null
    },
    "Total Dividend Per Share": {
      "thesisField": "dividends_per_share",
      "sign": 1,
      "tolerance": "exact",
      "notes": "Not all companies pay dividends"
    },
    "Non-Controlling/Minority Interests": {
      "thesisField": null,
      "sign": 1,
      "tolerance": "informational",
      "notes": "IS NCI adjustment — tracked separately from BS minority_interest"
    },
    "Total Net Finance Income/Expense": {
      "thesisField": null,
      "sign": 1,
      "tolerance": "informational",
      "notes": "Combined interest income/expense. MS-specific aggregation."
    },
    "Reported Effective Tax Rate": {
      "thesisField": "effective_tax_rate",
      "sign": 1,
      "tolerance": "approximate",
      "notes": "Derived in Thes1s as income_tax / income_before_tax. MS stores as decimal (0.24 = 24%)"
    }
  },
